# Supabase connection for cloud login + sync.
# Copy this file to ".env" and fill in the values from your Supabase project
# (Project Settings -> API). Both values are safe to embed in the app; access
# is protected by Row-Level Security. Do NOT use the service_role key here.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- Discord-gated login (Edge Function secrets) ----------------------------
# These are NOT used by the app build. They are set on Supabase for the
# verify-membership Edge Function only:
#   supabase secrets set DISCORD_BOT_TOKEN=... DISCORD_GUILD_ID=...
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions
# automatically.) They are listed here purely as a reminder of what to
# configure - see supabase/README.md for the full walkthrough.
# DISCORD_BOT_TOKEN=your-discord-bot-token
# DISCORD_GUILD_ID=your-mentorship-server-id
#
# Mentorship videos (Edge Function secrets only - NEVER VITE_ / never ship in the app):
#   MENTORSHIP_API_BASE_URL   (HTTPS Railway service base, no trailing slash required)
#   MENTORSHIP_API_TOKEN      (dedicated rotatable credential; not Stripe/Discord/Supabase keys)
#   BUNNY_STREAM_LIBRARY_ID
#   BUNNY_STREAM_TOKEN_KEY    (Token Authentication key from the Bunny library Security page)
#   BUNNY_STREAM_API_KEY      (library API key: uploads, deletes, encoding status)
#   BUNNY_STREAM_CDN_HOSTNAME (optional, thumbnails)
#   DISCORD_ROLE_*            (optional overrides of the built-in Discord role IDs)
# See docs/video-platform.md and docs/bot-handoff-member-access-api.md.
#
# The web app build on GitHub Actions reads VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY
# from repository *variables* (see docs/web-hosting.md), not from this file.
